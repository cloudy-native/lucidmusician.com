# Google Analytics 4 measurement ID (Admin → Data Streams → Web → Measurement ID)
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console HTML-tag verification (Search Console → Settings → Ownership verification)
PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-token

PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX

# Google Ads conversion ID (Ads ID + conversion label, e.g. AW-123456/abcDEF)
PUBLIC_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXXX/XXXXXXXXXXXXXX
