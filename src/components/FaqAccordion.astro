---
import type { FaqItem } from "../data/support-faqs";

interface Props {
  faqs: FaqItem[];
}

const { faqs } = Astro.props;
---

<section class="max-w-4xl mx-auto mb-12" aria-labelledby="faq-heading">
  <h2 id="faq-heading">Frequently Asked Questions</h2>
  <p class="faq-lede">Quick answers to the most common support questions.</p>
  <dl class="faq">
    {
      faqs.map((faq) => (
        <div class="faq-pair">
          <dt>{faq.question}</dt>
          <dd>{faq.answer}</dd>
        </div>
      ))
    }
  </dl>
</section>

