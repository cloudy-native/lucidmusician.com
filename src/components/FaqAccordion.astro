---
import { Icon } from 'astro-icon/components';
import type { FaqItem } from "../data/support-faqs";

interface Props {
  faqs: FaqItem[];
}

const { faqs } = Astro.props;
---

<section class="max-w-4xl mx-auto mb-12" aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="text-2xl font-bold mb-2" style="color: var(--color-text);">
    Frequently Asked Questions
  </h2>
  <p class="mb-6" style="color: var(--color-text-muted);">
    Quick answers to the most common support questions.
  </p>
  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details class="group rounded-xl transition-shadow" style="border: 1px solid var(--color-border); background-color: var(--color-bg-card);">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-semibold marker:content-none [&::-webkit-details-marker]:hidden" style="color: var(--color-text);">
            <span>{faq.question}</span>
            <Icon name="lucide:chevron-down" class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180" style="color: var(--color-text-subtle);" aria-hidden="true" />
          </summary>
          <p class="px-5 pb-4 leading-relaxed" style="color: var(--color-text-muted);">{faq.answer}</p>
        </details>
      ))
    }
  </div>
</section>
