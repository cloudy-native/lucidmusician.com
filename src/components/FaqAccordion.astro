---
import { Icon } from 'astro-icon/components';
import type { FaqItem } from "../data/support-faqs";

interface Props {
  faqs: FaqItem[];
}

const { faqs } = Astro.props;
---

<section class="max-w-4xl mx-auto mb-12" aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="text-2xl font-bold text-gray-900 mb-2">
    Frequently Asked Questions
  </h2>
  <p class="text-gray-600 mb-6">
    Quick answers to the most common support questions.
  </p>
  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details class="group rounded-xl border border-gray-200 bg-gray-50 open:border-violet-200 open:bg-white open:shadow-sm transition-shadow">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-semibold text-gray-900 marker:content-none [&::-webkit-details-marker]:hidden">
            <span>{faq.question}</span>
            <Icon name="lucide:chevron-down" class="h-5 w-5 shrink-0 text-gray-400 transition-transform group-open:rotate-180" aria-hidden="true" />
          </summary>
          <p class="px-5 pb-4 text-gray-600 leading-relaxed">{faq.answer}</p>
        </details>
      ))
    }
  </div>
</section>