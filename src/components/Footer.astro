---
import { Image } from "astro:assets";
import { PLUGIN_COMPARISON_PATH } from "../lib/blog";
import landing from "../data/landing-content.json";
import logo from "../assets/images/LH-logo-small-cropped.jpg";

const year = new Date().getFullYear();
const gumroad = "https://lucidmusician.gumroad.com/l/lucid-harmony";
const ticket = "https://lucidmusician.zohodesk.com/portal/en/newticket";
---

<footer class="foot">
  <div class="mark">
    <Image src={logo} alt="LucidHarmony" width={56} height={56} />
    <span class="wm-name">LucidHarmony</span>
    <span class="wm-line">Gorgeous infinite harmony.</span>
  </div>
  <div class="colophon">
    <div class="links">
      <a href="/docs">Docs</a> &middot;
      <a href="/support">Support</a> &middot;
      <a href="/release-notes">Releases</a> &middot;
      <a href="/blog">Blog</a> &middot;
      <a href="/about">About</a> &middot;
      <a href={PLUGIN_COMPARISON_PATH}>Compare</a> &middot;
      <a href={ticket} target="_blank" rel="noopener noreferrer">Ticket</a> &middot;
      <a href="mailto:support@lucidmusician.com">Email</a> &middot;
      <a href={gumroad} target="_blank" rel="noopener noreferrer">Buy</a>
    </div>
    <p class="ethos">{landing.content.footer.ethos}</p>
    <p class="copyright">© {year} Lucid Musician. All rights reserved.</p>
  </div>
</footer>
