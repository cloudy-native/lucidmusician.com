---
import type { CollectionEntry } from "astro:content";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section
      class="max-w-4xl mx-auto mt-12 mb-4"
      aria-labelledby="related-articles-heading"
    >
      <h2
        id="related-articles-heading"
        class="text-2xl font-bold mb-6"
        style="color: var(--color-text);"
      >
        Related Articles
      </h2>
      <div class="grid grid-cols-1 gap-4">
        {posts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="group block rounded-xl p-5 transition-all hover:shadow-sm"
            style="border: 1px solid var(--color-border); background-color: var(--color-bg-card);"
          >
            <div class="flex flex-wrap items-center gap-2 text-sm mb-2" style="color: var(--color-text-subtle);">
              <span>
                {new Date(post.data.date).toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </span>
              <span>•</span>
              <span>{post.data.readTime}</span>
            </div>
            <h3 class="text-lg font-semibold transition-colors" style="color: var(--color-text);">
              {post.data.title}
            </h3>
            <p class="mt-2 text-sm" style="color: var(--color-text-muted);">{post.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )
}
