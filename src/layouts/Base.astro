---
import "../styles/global.css";
import StructuredData from "../components/StructuredData.astro";
import {
  GOOGLE_SITE_VERIFICATION,
  GTAG_IDS,
  PRIMARY_GTAG_ID,
} from "../lib/analytics";
import { HERO_IMAGE, organization } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  articlePublishedTime?: string;
  articleModifiedTime?: string;
}

const {
  title,
  description,
  canonical,
  noindex = false,
  ogType = "website",
  articlePublishedTime,
  articleModifiedTime,
} = Astro.props;
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    {GOOGLE_SITE_VERIFICATION && (
      <meta
        name="google-site-verification"
        content={GOOGLE_SITE_VERIFICATION}
      />
    )}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    {ogType === "article" && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {ogType === "article" && articleModifiedTime && (
      <meta property="article:modified_time" content={articleModifiedTime} />
    )}
    <meta property="og:image" content={HERO_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="LucidHarmony" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={HERO_IMAGE} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/images/LH-logo-small-cropped.jpg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Analytics (GA4 + Google Ads) -->
    {
      PRIMARY_GTAG_ID && (
        <>
          <script
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${PRIMARY_GTAG_ID}`}
          />
          <script
            is:inline
            define:vars={{ gtagIds: GTAG_IDS }}
          >
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtagIds.forEach((id) => gtag("config", id));
          </script>
        </>
      )
    }

    <!-- Gumroad (loaded only when needed by link) -->
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />

    <!-- Zoho SalesIQ -->
    <script is:inline>
      var $zoho=$zoho||{};$zoho.salesiq=$zoho.salesiq||{ready:function(){}};
      var d=document,s=d.createElement("script");
      s.id="zsiqscript";s.defer=true;
      s.src="https://salesiq.zoho.com/widget?wc=siqdf47e495f388af9ebb6313380d12b6d6e4ddba171f75f59d971f83f9c8b6d9ad";
      d.body.appendChild(s);
    </script>

    <!-- Organization structured data (site-wide) -->
    <StructuredData data={organization} />
  </body>
</html>
