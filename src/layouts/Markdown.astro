---
import Page from "./Page.astro";

interface Props {
  title: string;
  description: string;
  showCta?: boolean;
  ogType?: "website" | "article";
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  showCta = false,
  ogType,
  articlePublishedTime,
  articleModifiedTime,
  structuredData,
} = Astro.props;
const fullTitle = `${title} | LucidHarmony`;
const hasSidebar = Astro.slots.has("sidebar");
---

<Page
  title={fullTitle}
  description={description}
  ogType={ogType}
  articlePublishedTime={articlePublishedTime}
  articleModifiedTime={articleModifiedTime}
  structuredData={structuredData}
>
  <div
    class:list={[
      "py-10 w-full min-w-0",
      hasSidebar && "lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-10",
    ]}
  >
    {hasSidebar && (
      <aside class="docs-gutter mb-8 lg:mb-0 min-w-0 lg:self-start lg:sticky lg:top-[4.75rem] lg:max-h-[calc(100dvh-5.25rem)] lg:overflow-y-auto">
        <slot name="sidebar" />
      </aside>
    )}

    <div class="min-w-0">
      <div class="kami-page-header mb-12">
        <h1 class="text-3xl md:text-4xl font-bold break-words" style="color: var(--color-text);">{title}</h1>
        <p class="text-base md:text-lg mt-4" style="color: var(--color-text-muted);">{description}</p>
      </div>

      {Astro.slots.has("prepend") && (
        <slot name="prepend" />
      )}

      <article class="prose prose-lg max-w-4xl mx-auto overflow-x-hidden [&>*]:max-w-full">
        <slot />
      </article>

      {Astro.slots.has("append") && (
        <slot name="append" />
      )}
    </div>
  </div>

  {showCta && (
    <div class="mt-12 mb-16 max-w-4xl mx-auto rounded-2xl p-8 text-center" style="border: 1px solid var(--color-border); background-color: var(--color-bg-card);">
      <h3 class="text-xl font-bold mb-3" style="color: var(--color-text);">Try LucidHarmony</h3>
      <p class="mb-5 max-w-lg mx-auto" style="color: var(--color-text-muted);">
        Gorgeous, infinite chord progressions for ambient and scoring — powered by the AI techniques discussed in this article.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="https://lucidmusician.gumroad.com/l/lucid-harmony"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary gumroad-button"
        >
          Get LucidHarmony
        </a>
        <a href="/docs" class="btn-ghost">
          Read the Docs
        </a>
        <a href="/blog" class="btn-ghost">
          More Articles
        </a>
      </div>
    </div>
  )}
</Page>

<style>
  @media (min-width: 1024px) {
    .docs-gutter {
      overscroll-behavior: contain;
      scrollbar-width: thin;
    }
  }
</style>
