---
import Page from "./Page.astro";

interface Props {
  title: string;
  description: string;
  showCta?: boolean;
  ogType?: "website" | "article";
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  showCta = false,
  ogType,
  articlePublishedTime,
  articleModifiedTime,
  structuredData,
} = Astro.props;
const fullTitle = `${title} | LucidHarmony`;
---

<Page
  title={fullTitle}
  description={description}
  ogType={ogType}
  articlePublishedTime={articlePublishedTime}
  articleModifiedTime={articleModifiedTime}
  structuredData={structuredData}
>
  <div class="py-10 w-full min-w-0">
    <div class="text-center mb-12">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 break-words">{title}</h1>
      <p class="text-base md:text-lg text-gray-600 mt-4 max-w-3xl mx-auto">{description}</p>
    </div>

    {Astro.slots.has("prepend") && (
      <slot name="prepend" />
    )}

    <article class="prose prose-lg max-w-4xl mx-auto overflow-x-hidden [&>*]:max-w-full">
      <slot />
    </article>

    {Astro.slots.has("append") && (
      <slot name="append" />
    )}
  </div>

  {showCta && (
    <div class="mt-12 mb-16 max-w-4xl mx-auto rounded-2xl border border-violet-500/30 bg-gradient-to-br from-violet-50 via-transparent to-transparent p-8 text-center">
      <h3 class="text-xl font-bold text-gray-900 mb-3">Try LucidHarmony</h3>
      <p class="text-gray-600 mb-5 max-w-lg mx-auto">
        Gorgeous, infinite chord progressions for ambient and scoring — powered by the AI techniques discussed in this article.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="https://lucidmusician.gumroad.com/l/lucid-harmony"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-6 py-3 rounded-full bg-gradient-to-r from-violet-600 to-cyan-600 text-white font-semibold shadow-lg hover:shadow-xl transition-shadow"
        >
          Get LucidHarmony
        </a>
        <a href="/docs" class="inline-flex items-center px-6 py-3 rounded-full border border-gray-300 text-gray-700 font-semibold hover:border-violet-500 transition-colors">
          Read the Docs
        </a>
        <a href="/blog" class="inline-flex items-center px-6 py-3 rounded-full border border-gray-300 text-gray-700 font-semibold hover:border-violet-500 transition-colors">
          More Articles
        </a>
      </div>
    </div>
  )}
</Page>
