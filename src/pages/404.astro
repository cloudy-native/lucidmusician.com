---
import Page from "../layouts/Page.astro";
---

<Page
  title="404 - Page Not Found | LucidHarmony"
  description="The page you're looking for doesn't exist."
>
  <section class="flex flex-col items-center justify-center py-20 text-center">
    <div class="mx-auto mb-8 w-48 md:w-64">
      <img src="/images/sad-music-note.png" alt="Sad music note" class="h-auto w-full" />
    </div>
    <div class="text-7xl md:text-8xl font-bold tracking-tight text-gray-700">404</div>
    <h1 class="mt-4 text-3xl font-bold bg-gradient-to-r from-violet-400 to-cyan-400 bg-clip-text text-transparent">
      Page not found
    </h1>
    <p class="mt-4 text-gray-600">The page you're looking for doesn't exist (or it may have moved).</p>
    <div class="mt-10 flex gap-4">
      <a href="/" class="rounded-full bg-violet-600 px-6 py-3 font-semibold text-white hover:bg-violet-500 transition-colors">Go Home</a>
      <a href="/docs" class="rounded-full border border-gray-300 px-6 py-3 font-semibold text-gray-600 hover:border-violet-500 transition-colors">Docs</a>
    </div>
  </section>
</Page>
