---
import Page from "../layouts/Page.astro";
import { Image } from 'astro:assets';
import sadNote from '../assets/images/sad-music-note.png';
---

<Page
  title="404 - Page Not Found | LucidHarmony"
  description="The page you're looking for doesn't exist."
>
  <section class="flex flex-col items-center justify-center py-20 text-center">
    <div class="mx-auto mb-8 w-48 md:w-64">
      <Image src={sadNote} alt="Sad music note" class="h-auto w-full" widths={[240, 320, 400]} sizes="200px" />
    </div>
    <div class="kami-404-num">404</div>
    <h1 class="kami-404-title">
      Page not found
    </h1>
    <p class="mt-4" style="color: var(--color-text-muted);">The page you're looking for doesn't exist (or it may have moved).</p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href="/" class="btn-primary">Go Home</a>
      <a href="/docs" class="btn-ghost">Docs</a>
    </div>
  </section>
</Page>
