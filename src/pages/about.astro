---
import Page from "../layouts/Page.astro";
import { Image } from 'astro:assets';

const headshotModules = import.meta.glob('../assets/images/headshots/*.jpeg', { eager: true, import: 'default' }) as Record<string, ImageMetadata>;

function getHeadshot(name: string) {
  const key = `../assets/images/headshots/${name}`;
  return headshotModules[key];
}


const teamMembers = [
  {
    name: "S. J. Harrison",
    jobTitle: "Chief Executive Officer",
    motto: "Always delegate",
    bio: "SJ incorporated a company with a complete C-suite. They all answer to the same bathroom mirror. His job is to point Lucid Musician at the interesting problems and the other Stephens at everything else.",
    imageSrc: "/images/headshots/ceo.jpeg",
  },
  {
    name: "J. Roger Harrison",
    jobTitle: "Chief Music Officer",
    motto: "You pay extra for black notes",
    bio: "Roger is the one who actually listens. If a chord is theoretically correct and musically boring, it does not ship. He tests every feature as if a session is booked at ten, because in his head it is.",
    imageSrc: "/images/headshots/musician.jpeg",
  },
  {
    name: "Dr. Stephen James Harrison, PhD",
    jobTitle: "Lead Software Engineer",
    motto: "It builds, it ships",
    bio: "The doctorate was the respectable chapter. Then he spent it on a MIDI plugin, a website, and a build matrix that would make a thesis committee weep. He writes the code, reviews the code, and is, regrettably, also the CI.",
    imageSrc: "/images/headshots/developer.jpeg",
  },
  {
    name: "S. James-Roger Harrison",
    jobTitle: "Brand & Visual Designer",
    motto: "I don't do pixels or RGB",
    bio: "He does, in fact, do both. He just prefers not to be caught. Brand, layout, and the quiet removal of anything that looks like it was designed at 2 a.m. remain his department of one.",
    imageSrc: "/images/headshots/design.jpeg",
  },
  {
    name: "Steve Harrison",
    jobTitle: "Chief Content Officer",
    motto: "As long as the lighting's good",
    bio: "Steve writes the docs, the tutorials, and the release notes, then takes a headshot to prove a human was involved. If a sentence needs a trumpet emoji, it is not finished.",
    imageSrc: "/images/headshots/content.jpeg",
  },
  {
    name: "Harrison, Stephen J. R.",
    jobTitle: "CFO (and Head of Accounting)",
    motto: "No such thing as a rounding error",
    bio: "Payroll has one row, which keeps the close short. The books are in C: balanced, slightly cheaper than they should be, and never accidentally in 7/8.",
    imageSrc: "/images/headshots/cfo.jpeg",
  },
];
---

<Page
  title="About | LucidHarmony"
  description="Meet the team behind LucidHarmony, the AI-powered chord progression generator for ambient music and film scoring."
>
  <section class="py-10">
    <div class="kami-page-header mb-10">
      <h1 class="text-4xl font-bold text-[var(--color-text)]">The Lucid Musician Team</h1>
      <p class="text-[var(--color-text-muted)] mt-4 max-w-3xl">
        A dedicated and eclectic team of specialists, who are not at all the same person really.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
      {teamMembers.map((member) => (
        <div class="overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-card)]">
          <div class="aspect-square w-full bg-[var(--color-bg-muted)]">
            <Image
              src={getHeadshot(member.imageSrc.split('/').pop()!)}
              alt={member.name}
              class="h-full w-full object-cover"
              widths={[320, 480, 640]}
              sizes="320px"
              loading="lazy"
            />
          </div>
          <div class="p-6">
            <div class="text-xs font-semibold tracking-wide text-[var(--color-text-subtle)]">{member.jobTitle}</div>
            <div class="mt-1 text-xl font-semibold text-[var(--color-text)]">{member.name}</div>
            <div class="mt-3 text-sm text-[var(--color-text-muted)] italic">"{member.motto}"</div>
            <p class="mt-4 text-sm leading-relaxed text-[var(--color-text-muted)]">{member.bio}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</Page>
