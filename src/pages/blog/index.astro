---
import { getCollection } from "astro:content";
import Page from "../../layouts/Page.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Page
  title="Blog | LucidHarmony"
  description="Articles about AI-powered music generation, chord progression theory, audio plugin development, and the technology behind LucidHarmony."
>
  <section class="py-10">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-[var(--color-text)]">The Lucid Musician Blog</h1>
      <p class="text-lg text-[var(--color-text-muted)] mt-4">Latest articles, tutorials, and insights from our team</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
      {posts.map((post) => (
        <a
          href={`/blog/${post.id}`}
          class="group block p-6 rounded-lg border border-[var(--color-border)] transition-all hover:shadow-lg bg-[var(--color-bg-card)]"
        >
          <div class="flex flex-col h-full">
            <div class="flex items-center gap-2 text-sm text-[var(--color-text-subtle)] mb-3">
              <span>{new Date(post.data.date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</span>
              <span>•</span>
              <span>{post.data.readTime}</span>
            </div>
            <h2 class="text-xl font-semibold mb-3 text-[var(--color-text)] group-hover:text-violet-400 transition-colors">
              {post.data.title}
            </h2>
            <p class="text-[var(--color-text-muted)] mb-4 flex-grow">{post.data.description}</p>
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="text-xs px-2 py-1 rounded-full bg-[var(--color-badge-bg)] text-[var(--color-badge-text)]">#{tag}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</Page>
