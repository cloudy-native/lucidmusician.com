---
import { getCollection } from "astro:content";
import Page from "../../layouts/Page.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Page
  title="Blog | LucidHarmony"
  description="Articles about AI-powered music generation, chord progression theory, audio plugin development, and the technology behind LucidHarmony."
>
  <section class="py-10">
    <div class="kami-page-header mb-12">
      <h1 class="text-4xl font-bold text-[var(--color-text)]">The Lucid Musician Blog</h1>
      <p class="text-lg text-[var(--color-text-muted)] mt-4">Latest articles, tutorials, and insights from our team</p>
    </div>

    <ol class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`}>
            <p class="meta">
              {new Date(post.data.date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
              {" · "}
              {post.data.readTime}
            </p>
            <h2>{post.data.title}</h2>
            <p class="dek">{post.data.description}</p>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Page>
