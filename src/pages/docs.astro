---
import { getEntry, render } from "astro:content";
import Markdown from "../layouts/Markdown.astro";
import { PLUGIN_COMPARISON_PATH } from "../lib/blog";

const page = await getEntry("pages", "docs");
const { Content } = await render(page);
---

<Markdown title={page.data.title} description={page.data.description}>
  <div
    slot="prepend"
    class="max-w-4xl mx-auto mb-12 rounded-xl p-6"
    style="border: 1px solid var(--color-border); background-color: var(--color-bg-card);"
  >
    <h2 class="font-bold mb-2" style="color: var(--color-text);">How does LucidHarmony compare?</h2>
    <p class="text-sm mb-4" style="color: var(--color-text-muted);">
      We surveyed harmonic generator plugins for DAWs — Scaler, Captain Chords,
      ChordJam, Spacewalk, and more — with an honest feature and pricing
      breakdown.
    </p>
    <a
      href={PLUGIN_COMPARISON_PATH}
      class="inline-flex items-center font-semibold transition-colors"
      style="color: var(--color-accent-light);"
    >
      Read the plugin comparison →
    </a>
  </div>
  <Content />
</Markdown>