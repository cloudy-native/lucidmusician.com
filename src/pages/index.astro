---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const features = [
  { title: "50% Off — Limited Time", description: "$10 today (regular price $20). 30-day money-back guarantee and free lifetime updates included.", colorClass: "text-emerald-600" },
  { title: "Trained on 3,700+ Compositions", description: "We trained a powerful AI model on over 290,000 chords and sequences, expertly extracted from more than 18MB of MIDI data.", colorClass: "text-sky-600" },
  { title: "Intelligent Voice Leading", description: "Automatic voice leading that follows traditional counterpoint rules, or explores modern harmonic possibilities with customizable parameters.", colorClass: "text-fuchsia-600" },
  { title: "Instant MIDI Export", description: "Drag and drop harmonic sequences into your DAW as single or multi-track MIDI, with configurable voice separation.", colorClass: "text-amber-600" },
  { title: "Intuitive Harmony Explorer", description: "Edit progressions with scored alternatives, re-voicing, and parameter adjustments. Regenerate and revoice as many times as you like.", colorClass: "text-rose-600" },
  { title: "Flexible & Customizable", description: "Fine-tune generation with controls for creativity, voicing preferences, parallel intervals, harmonic styles, key, mode, and more.", colorClass: "text-indigo-600" },
];

const steps = [
  { title: "1. Set Your Parameters", description: "Choose your key, mode, and harmonic style. Adjust creativity and voicing preferences to taste.", image: "set-harmonic-foundation.png" },
  { title: "2. Generate Harmonies", description: "Click Generate to create AI-powered chord progressions. Each generation is unique and musically coherent.", image: "generate-sequence.png" },
  { title: "3. Refine & Voice", description: "Adjust voicing parameters to explore different voice leading options. Build sequences using the intuitive harmony explorer.", image: "refine-voicing.png" },
  { title: "4. Export to Your DAW", description: "Drag the MIDI directly into your project. Single or multi-track export with perfect voice separation.", image: "export-midi.png" },
  { title: "5. Become a Harmonic Wizard", description: "Drop into Edit Mode to create your own sequences interactively, guided by the same AI used by the generator.", image: "edit-mode.png" },
];

const ctaHref = "https://lucidmusician.gumroad.com/l/lucid-harmony";
---

<Base
  title="LucidHarmony - Gorgeous Infinite Harmony for Ambient and Scoring"
  description="LucidHarmony generates gorgeous, infinite chord progressions for ambient music and film scoring. AI-powered MIDI plugin for any DAW on Windows, Mac, and Linux."
>
  <Navbar />
  <main>
    <!-- Hero Section -->
    <section class="relative flex flex-col items-center justify-center gap-4 py-16 md:py-24 px-4">
      <div class="absolute inset-0 -z-10 bg-gradient-to-b from-violet-100 via-white to-white"></div>

      <div class="max-w-5xl text-center">
        <h1 class="bg-gradient-to-r from-violet-600 to-cyan-600 bg-clip-text text-transparent text-5xl md:text-7xl lg:text-8xl font-bold">
          Gorgeous Infinite Harmony
        </h1>
        <p class="mt-6 text-xl md:text-2xl text-gray-600 max-w-3xl mx-auto">
          AI-powered chord progressions for ambient music and film scoring. Any DAW, any platform.
        </p>

        <div class="h-10"></div>

        <!-- Feature Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
          <div class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">
            <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-violet-100 text-violet-600">
              <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">Infinite Variety</h3>
            <p class="text-lg text-gray-600 leading-relaxed">Every sequence unique. Clever voicing, always configurable. Any key, tempo, note length.</p>
          </div>

          <div class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">
            <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-cyan-100 text-cyan-600">
              <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">Theory Built-In</h3>
            <p class="text-lg text-gray-600 leading-relaxed">Steeped in music theory, so you don't have to be. From drifting ambient to choral to cinematic.</p>
          </div>

          <div class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">
            <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-green-100 text-green-600">
              <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">Fair & Forever</h3>
            <p class="text-lg text-gray-600 leading-relaxed">50% off right now — just $10. No-risk 30-day guarantee. Free updates forever.</p>
          </div>
        </div>

        <div class="h-10"></div>

        <!-- Platform badges -->
        <div class="flex flex-wrap items-center justify-center gap-4 md:gap-6">
          <div class="flex items-center gap-2 px-5 py-2 rounded-full bg-gray-100 border border-gray-200">
            <span class="text-xl">🪟</span>
            <span class="text-base font-medium text-gray-700">Windows</span>
          </div>
          <div class="flex items-center gap-2 px-5 py-2 rounded-full bg-gray-100 border border-gray-200">
            <span class="text-xl">🍎</span>
            <span class="text-base font-medium text-gray-700">Mac</span>
          </div>
          <div class="flex items-center gap-2 px-5 py-2 rounded-full bg-gray-100 border border-gray-200">
            <span class="text-xl">🐧</span>
            <span class="text-base font-medium text-gray-700">Linux</span>
          </div>
        </div>
      </div>

      <div class="h-6"></div>

      <!-- Hero Image -->
      <div class="w-full max-w-5xl">
        <img src="/lucid-harmony-hero.com.png" alt="LucidHarmony plugin interface showing AI-generated chord progressions" class="w-full h-auto rounded-2xl shadow-xl border border-gray-200" />
      </div>

      <div class="h-8"></div>

      <a href={ctaHref} target="_blank" rel="noopener noreferrer" class="gumroad-button inline-flex items-center rounded-full bg-violet-600 hover:bg-violet-700 text-white font-semibold text-lg px-8 py-4 shadow-md hover:shadow-lg transition-all">
        Get LucidHarmony for $10 🎉
      </a>
      <p class="mt-4 text-center text-base md:text-lg text-gray-500">
        🔥 50% off — was $20 · 🛡️ 30-day money-back guarantee
      </p>
    </section>

    <!-- Testimonials -->
    <section class="py-16 px-4 border-t border-gray-100">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="text-2xl mb-3">⭐⭐⭐⭐⭐</div>
            <p class="text-gray-600 italic">"This is amazing. I use it every day, sometimes just for fun. I can create compelling ambient tracks super easily."</p>
            <p class="mt-3 text-sm font-semibold text-gray-900">— Verified purchase</p>
            <p class="text-xs text-gray-500">Ambient Producer</p>
          </div>
          <div class="text-center">
            <div class="text-2xl mb-3">⭐⭐⭐⭐⭐</div>
            <p class="text-gray-600 italic">"Beautiful chord progressions perfect for ambient music are easily created simply by playing them slowly. It's an ultimate tool that lets even beginners intuitively learn the magic of harmony, giving you the inspiring experience of collaborating across time with history's greatest musicians!"</p>
            <p class="mt-3 text-sm font-semibold text-gray-900">— だいすけ</p>
            <p class="text-xs text-gray-500">Music Student</p>
          </div>
          <div class="text-center">
            <div class="text-2xl mb-3">⭐⭐⭐⭐⭐</div>
            <p class="text-gray-600 italic">"I saw this on Apple. I definitely see it's potential. So glad to see it offered for Windows. Thank you.."</p>
            <p class="mt-3 text-sm font-semibold text-gray-900">— Verified purchase</p>
            <p class="text-xs text-gray-500">Sound Designer</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Video Demo Section -->
    <section class="py-20 px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-4xl md:text-5xl font-bold bg-gradient-to-r from-violet-600 to-cyan-600 bg-clip-text text-transparent">
            See It In Action
          </h2>
        </div>

        <!-- Main demo video -->
        <div class="w-full max-w-5xl mx-auto mb-16">
          <div class="aspect-video overflow-hidden rounded-2xl border border-gray-200 bg-gray-50 shadow-xl relative">
            <lite-youtube videoid="zZXODsd1zlY" playlabel="Play: LucidHarmony Demo">
              <button type="button" class="lyt-playbtn" aria-label="Play: LucidHarmony Demo">
                <span class="lyt-visually-hidden">Play</span>
              </button>
            </lite-youtube>
          </div>
          <p class="mt-6 text-center text-lg text-gray-600 max-w-4xl mx-auto leading-relaxed">
            🎹 Drag MIDI straight from the plugin · 🌊 Pads, bass & windchimes · ⏱️ 60 BPM · ♾️ Infinite mode · 🚫 No MIDI controller · ✋ Zero hand editing
          </p>
        </div>

        <!-- Side by side: 30 seconds & 5 minutes -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          <div>
            <h3 class="text-xl font-bold text-gray-900 mb-4 text-center">In 30 seconds</h3>
            <div class="aspect-video overflow-hidden rounded-2xl border border-gray-200 bg-gray-50 shadow-md relative">
              <lite-youtube videoid="sSWSHgycSkk" playlabel="Play: LucidHarmony in 30 seconds">
                <button type="button" class="lyt-playbtn" aria-label="Play: LucidHarmony in 30 seconds"><span class="lyt-visually-hidden">Play</span></button>
              </lite-youtube>
            </div>
            <p class="mt-3 text-sm text-gray-500 text-center">Quick overview of the core workflow</p>
          </div>
          <div>
            <h3 class="text-xl font-bold text-gray-900 mb-4 text-center">In 5 minutes</h3>
            <div class="aspect-video overflow-hidden rounded-2xl border border-gray-200 bg-gray-50 shadow-md relative">
              <lite-youtube videoid="HgQNWbGRb7M" playlabel="Play: LucidHarmony in 5 minutes">
                <button type="button" class="lyt-playbtn" aria-label="Play: LucidHarmony in 5 minutes"><span class="lyt-visually-hidden">Play</span></button>
              </lite-youtube>
            </div>
            <p class="mt-3 text-sm text-gray-500 text-center">Full walkthrough with voicing and export</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 Step Demo -->
    <section class="py-20 px-4 bg-gray-50">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold text-center text-gray-900 mb-12">Three steps to beautiful harmony</h2>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
          <div class="flex flex-col gap-4">
            <div class="text-center lg:text-left lg:min-h-[140px]">
              <h3 class="text-2xl font-bold text-violet-600">1. Generate</h3>
              <p class="text-sm text-gray-600 mt-2">Pick an AI model, starting chord and key. Click "Generate". Get a random, harmonically-interesting story with any number of chords.</p>
            </div>
            <img src="/images/four-chord-harmony.png" alt="LucidHarmony generating a four-chord ambient progression with AI" class="w-full h-auto rounded-2xl shadow-lg object-cover lg:h-[320px]" />
          </div>
          <div class="flex flex-col gap-4">
            <div class="text-center lg:text-left lg:min-h-[140px]">
              <h3 class="text-2xl font-bold text-violet-600">2. Drag MIDI</h3>
              <p class="text-sm text-gray-600 mt-2">Drop it into Logic. Everything is beautifully voiced, including that stepwise bass line you've always wanted.</p>
            </div>
            <img src="/images/beautifully-voiced.png" alt="Beautifully voiced MIDI chord voicings exported to a DAW piano roll" class="w-full h-auto rounded-2xl shadow-lg object-cover lg:h-[320px]" />
          </div>
          <div class="flex flex-col gap-4">
            <div class="text-center lg:text-left lg:min-h-[140px]">
              <h3 class="text-2xl font-bold text-violet-600">3. Any Instrument!</h3>
              <p class="text-sm text-gray-600 mt-2">Assign your favorite instrument for lush pads, choir, or ear candy. Here is a quick sketch from one generated progression.</p>
            </div>
            <iframe
              width="100%"
              height="320"
              scrolling="no"
              frameborder="0"
              allow="autoplay"
              loading="lazy"
              title="SoundCloud player"
              class="w-full overflow-hidden rounded-2xl border border-gray-200 shadow-lg h-[220px] sm:h-[260px] lg:h-[320px]"
              src="https://w.soundcloud.com/player/?url=https%3A%2F%2Fapi.soundcloud.com%2Ftracks%2F2234115233&color=%230066cc&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true&visual=true"
            ></iframe>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="py-20 px-4">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold text-center text-gray-900">Key Features</h2>
        <div class="h-12"></div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map((feature) => (
            <div class="p-6 rounded-xl bg-white border border-gray-200 hover:shadow-md transition-shadow">
              <h3 class:list={["text-xl font-bold mb-3", feature.colorClass]}>{feature.title}</h3>
              <p class="text-gray-600">{feature.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How It Works Section -->
    <section class="py-20 px-4 bg-gray-50">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold text-center text-gray-900">How It Works</h2>
        <div class="h-12"></div>
        <div class="space-y-16">
          {steps.map((step, index) => (
            <div class={`flex flex-col ${index % 2 === 0 ? "md:flex-row" : "md:flex-row-reverse"} gap-8 items-center`}>
              <div class="flex-1 w-full">
                <div class="aspect-video rounded-xl shadow-md bg-white border border-gray-200 overflow-hidden">
                  <img src={`/${step.image}`} alt={step.title} class="h-full w-full object-contain" loading="lazy" />
                </div>
              </div>
              <div class="flex-1">
                <h3 class="text-2xl font-bold text-violet-600">{step.title}</h3>
                <div class="h-4"></div>
                <p class="text-lg text-gray-600">{step.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Audio Samples Section -->
    <section class="py-20 px-4">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold text-center text-gray-900">Listen to more samples</h2>
        <div class="h-12"></div>
        <div class="w-full max-w-4xl mx-auto">
          <p class="text-lg text-gray-600 mb-4">
            All samples in this album were created using LucidHarmony. MIDI was exported unedited into DAW tracks. No keyboards, no editing, no tweaking.
          </p>
          <p class="text-lg text-gray-600 mb-8">
            The instruments are Omnisphere 3, Pigments 7, and Ashlight 2 in Kontakt 8 by Native Instruments. All this in Logic Pro, but works in any DAW.
          </p>
          <iframe
            width="100%"
            height="300"
            scrolling="no"
            frameborder="0"
            allow="autoplay"
            loading="lazy"
            title="SoundCloud album player"
            class="w-full overflow-hidden rounded-xl border border-gray-200"
            src="https://w.soundcloud.com/player/?url=https%3A%2F%2Fapi.soundcloud.com%2Fplaylists%2Fsoundcloud%3Aplaylists%3A2162448524&color=%230066cc&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true&visual=true"
          ></iframe>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-gray-900">Ready to Transform Your Workflow?</h2>
        <div class="h-4"></div>
        <p class="text-lg text-gray-600">Join musicians and composers using LucidHarmony to create beautiful, sophisticated harmonies in seconds.</p>
        <div class="h-8"></div>
        <a href={ctaHref} target="_blank" rel="noopener noreferrer" class="gumroad-button inline-flex items-center rounded-full bg-violet-600 hover:bg-violet-700 text-white font-semibold text-lg px-8 py-4 shadow-md hover:shadow-lg transition-all">
          Get LucidHarmony for $10 🎉
        </a>
        <p class="mt-4 text-sm text-gray-500">🔥 50% off — was $20 · 🛡️ 30-day money-back guarantee</p>
      </div>
    </section>
  </main>
  <Footer />

  <!-- lite-youtube-embed -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lite-youtube-embed@0.3.4/src/lite-yt-embed.min.css" />
  <script is:inline src="https://cdn.jsdelivr.net/npm/lite-youtube-embed@0.3.4/src/lite-yt-embed.min.js"></script>

  <!-- Structured Data -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "LucidHarmony",
    "description": "AI-powered MIDI chord progression generator that creates gorgeous, infinite harmony for ambient music and film scoring.",
    "url": "https://lucidmusician.com",
    "applicationCategory": "MultimediaApplication",
    "operatingSystem": "Windows, macOS, Linux",
    "offers": {
      "@type": "Offer",
      "price": "10",
      "priceCurrency": "USD",
      "description": "50% off - regular price $20"
    },
    "author": {
      "@type": "Organization",
      "name": "Lucid Musician",
      "url": "https://lucidmusician.com"
    },
    "screenshot": "https://lucidmusician.com/lucid-harmony-hero.com.png",
    "featureList": [
      "AI-powered chord progression generation",
      "Infinite unique sequences",
      "MIDI drag and drop export",
      "Music theory built-in",
      "Configurable voicing, key, tempo, and note length",
      "Works in any DAW"
    ]
  }
  </script>

  <!-- Conversion tracking -->
  <script is:inline>
    document.querySelectorAll('.gumroad-button').forEach(btn => {
      btn.addEventListener('click', () => {
        if (typeof gtag === 'function') {
          gtag('event', 'conversion', { send_to: 'AW-951228427/rn08CMKM5PECEIuwysUD' });
        }
      });
    });
  </script>
</Base>
